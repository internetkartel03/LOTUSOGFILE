# Supabase Configuration (REQUIRED)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Deploy target
# Use "builder" for the dedicated builder deployment.
# Leave unset for the mixed public + builder deployment.
# VITE_LOTUS_DEPLOY_TARGET=builder

# GitHub (Optional - for exporting to GitHub)
VITE_GITHUB_TOKEN=your-github-token
